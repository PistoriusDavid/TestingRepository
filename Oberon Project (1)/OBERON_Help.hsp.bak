                  <TopicKeyword BuildFlags="" Id="7f6723e9-7668-4308-a72b-ce58bbf98a10">
                    <Keyword m="2021-08-10T13:13:02.7776525Z">Drobný investičný majetok - kniha</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="a697059d-071e-4282-813d-403e5f126378">
                    <Keyword m="2021-08-10T13:12:39.4656914Z">Odpisová skupina - kniha drobného investičného majetku</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="e8696d82-e164-4ba3-9510-7e1172226e27">
