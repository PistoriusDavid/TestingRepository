                      </TopicLink>
                    </TopicLinks>
                    <TopicKeywords>
                      <TopicKeyword BuildFlags="" Id="3c41d243-dd47-4189-901d-f3669e53632f">
                        <Keyword m="2016-08-03T13:12:31.4393702Z">Peniaze na ceste</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="6d30e0ca-ac69-462e-81ac-9db7e9cdc2b6">
                        <Keyword m="2016-08-03T13:12:49.6241553Z">Prevod medzi pokladnicou a bankovým účtom</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="6933aa54-191d-4fca-9550-f346ae77122a">
                        <Keyword m="2016-08-03T13:13:45.0875737Z">Príklad účtovania prevodu medzi pokladnicou a bankovým účtom</Keyword>
                      </TopicKeyword>
                    </TopicKeywords>
