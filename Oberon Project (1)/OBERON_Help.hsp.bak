                <Category />
              </TopicLink>
              <TopicLink BuildFlags="" Id="76ab3fd3-3a02-49e5-87ff-91acd58f39f5" CategoryId="" TopicLinkCategorySource="SpecificValue" Target="9980b99c-4409-4422-9d70-9cdd8893d0f3">
                <Title m="2021-09-13T10:16:07.2377884Z">Fakturácia - všeobecne o koncepcii</Title>
                <Category />
              </TopicLink>
              <TopicLink BuildFlags="" Id="73192801-fce4-420a-b69b-376832a94a5c" CategoryId="" TopicLinkCategorySource="SpecificValue" Target="60bbb193-6ba6-495c-8c54-431baf8b966f">
                <Title m="2021-09-13T10:16:27.199842Z">Fakturácia - základné možnosti</Title>
                <Category />
              </TopicLink>
            </TopicLinks>
            <TopicKeywords>
              <TopicKeyword BuildFlags="" Id="56cdb07c-9603-487f-b9fe-f7b83f6bf00a">
                <Keyword m="2021-08-19T13:24:27.1839903Z">Jednoduché účtovníctvo - základné možnosti</Keyword>
