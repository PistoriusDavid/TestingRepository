&lt;TR&gt;
&lt;TD class=SK width=197&gt;ČSOB internetbanking&lt;/TD&gt;
&lt;TD class=SK align=left&gt;CSV&lt;BR&gt;TXT&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD class=SK width=197&gt;ČSOB homebanking&lt;/TD&gt;
&lt;TD class=SK align=left&gt;XML&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
