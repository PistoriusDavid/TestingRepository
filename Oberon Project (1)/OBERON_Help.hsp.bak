                        <TopicKeywords>
                          <TopicKeyword BuildFlags="" Id="4efd0af0-d6ac-4f6c-90bb-b82329d9359c">
                            <Keyword m="2022-08-15T08:15:28.4778382Z">Fiscal Universal Interface - pre používateľov</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="3dc422f9-feb7-4e3c-b9ec-9a9ebd24ad73">
                            <Keyword m="2022-08-15T07:59:56.0263587Z">Fiscal Universal Interface - pre vývojárov</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="4e4cc300-b5df-4f5a-a048-7770d675be8b">
                            <Keyword m="2022-08-16T07:05:44.8439848Z">Fiscal Universal Interface - všeobecné informácie</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="6690f603-fcae-4e08-92d0-29015bf96548">
                            <Keyword m="2022-08-16T07:06:12.39156Z">Driver - Fiscal Universal Interface</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="389b8b3d-2c2e-45b9-adda-150b2ff5da30">
                            <Keyword m="2022-08-16T07:06:25.2980147Z">Fiscal Universal Driver</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="c3c4f48d-c89d-4491-a5bc-78740cd73ded">
                            <Keyword m="2022-08-16T07:06:41.2916581Z">DLL knižnica - Fiscal Universal Interface</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="2387a7a2-74cc-40cd-b803-6a3aaf0a1407">
                            <Keyword m="2022-08-16T08:56:25.276367Z">Vzorová DLL knižnica (ovládač) - Fiscal Universal Interface</Keyword>
                          </TopicKeyword>
