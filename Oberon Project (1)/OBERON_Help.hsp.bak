                          <TopicKeyword BuildFlags="" Id="0bdaa44b-28ac-43d6-bf0e-61d7663ee58f">
                            <Keyword m="2021-05-03T08:17:06.7350216Z">CashRegister Universal Interface - nastavenie komunikácie</Keyword>
                          </TopicKeyword>
