                      </TopicLink>
                    </TopicLinks>
                    <TopicKeywords>
                      <TopicKeyword BuildFlags="" Id="74cb2532-c084-479f-84a4-91524c7ad2a6">
                        <Keyword m="2022-07-07T07:30:28.1194813Z">Peňažný denník - účtovná závierka - zrušenie</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="b6f009cc-a15d-4617-b36f-cb0f438e751d">
                        <Keyword m="2022-07-07T07:30:47.1162836Z">Účtovná závierka - peňažný denník - zrušenie</Keyword>
