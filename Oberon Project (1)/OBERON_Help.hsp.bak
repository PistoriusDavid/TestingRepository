&lt;TR&gt;
&lt;TD bgColor=#fff2cc width="20%"&gt;&lt;STRONG&gt;Uzatvorenie zmluvy&lt;/STRONG&gt;&lt;/TD&gt;
&lt;TD style="COLOR: rgb(0,0,0)" align=center&gt;&lt;IMG border=0 alt="" src="images/Forms/Menu/Form_menu_Cross.png"&gt;&lt;/TD&gt;
