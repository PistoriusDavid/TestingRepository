                    </TopicLinks>
                    <TopicKeywords>
                      <TopicKeyword BuildFlags="" Id="e969cb63-0a77-4085-a118-4e08fca401a4">
                        <Keyword m="2022-01-19T09:17:24.7470275Z">Rozšírená cenotvorba podľa obratov obchodných partnerov</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="315b4d10-1860-42c0-8732-81b5608f7a02">
                        <Keyword m="2022-01-19T09:18:44.3412826Z">Zľavy podľa obratov obchodných partnerov</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="02272450-8487-4e85-8aee-40e39c841686">
                        <Keyword m="2022-01-19T09:16:48.8777696Z">Obrat a zľavy - skupiny obchodných partnerov</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="929c5e02-0da1-45b7-9295-520bca3da9f3">
                        <Keyword m="2022-01-19T09:18:04.576929Z">Cenotvorba podľa výšky obratu obchodného partnera</Keyword>
                      </TopicKeyword>
