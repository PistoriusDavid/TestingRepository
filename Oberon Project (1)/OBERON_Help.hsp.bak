                      <TopicKeyword BuildFlags="" Id="b658ca96-2665-4027-b37d-3249b3b31c98">
                        <Keyword m="2021-10-07T13:00:02.8700341Z">Bonovacie zariadenia</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="797daa79-271f-4112-948c-bb4f901cf880">
                        <Keyword m="2021-10-07T13:00:15.8766078Z">Objednávky jedál a nápojov - zariadenia</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="35f0947b-e465-40db-9c8f-91a3e58e7fee">
                        <Keyword m="2021-10-08T07:09:56.8825993Z">Bonovacie tlačiarne</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="662a49d4-60e3-4e3f-b33c-5cc31a0e4920">
                        <Keyword m="2021-10-08T07:10:02.0113713Z">Bonovacie monitory</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="2e5ea5aa-3477-439b-8046-f8d12df67d89">
                        <Keyword m="2021-10-08T07:10:14.8209937Z">Objednávkové zariadenia</Keyword>
                      </TopicKeyword>
                    </TopicKeywords>
