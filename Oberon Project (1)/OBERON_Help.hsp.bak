                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="bcd55d15-9625-49f9-a5fa-5e926ed202f3">
                    <Keyword m="2016-06-15T12:42:24.2813386Z">Dokumenty k faktúre</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="92948e44-2a4e-4f67-9c93-fe765db950ce">
                    <Keyword m="2022-01-20T14:00:51.2487942Z">Prílohy - dokumenty a obrázky</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="28eb7f89-5e3b-4ef4-b6c6-93971bba7be0">
                    <Keyword m="2022-01-20T14:02:23.9901355Z">Prílohy k dokladom a záznamom (pohľadávka, výdajka, reklamácia/servis...)</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="6b9e78ec-cba2-43e0-a9f0-c414fe601fd3">
