                        <TopicKeywords>
                          <TopicKeyword BuildFlags="" Id="8036cea3-cae4-4fd1-a8fa-bee2ce1f0268">
                            <Keyword m="2023-10-17T13:04:57.3074497Z">Fiscal Universal Interface - nastavenie komunikácie - formulár</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="b22e4722-ea4a-44b3-98d3-b24cac4f4d3b">
                            <Keyword m="2022-08-15T08:16:10.2436204Z">Inštalácia fiškálnej tlačiarne - Fiscal Universal Interface</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="b232226b-a719-4465-8fe2-879aa57752f2">
