&lt;P align=right&gt;&amp;nbsp;600.000&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=75&gt;
&lt;P align=right&gt;&amp;nbsp; 3 000&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=161&gt;
&lt;P align=left&gt;Štrk jemný&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=66&gt;
&lt;P align=right&gt;&amp;nbsp;2 t&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=88&gt;
&lt;P align=right&gt;&amp;nbsp;600.000&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=75&gt;
&lt;P align=right&gt;&amp;nbsp; 1 200&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=161&gt;
&lt;P align=right&gt;&amp;nbsp;&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=66&gt;
&lt;P align=right&gt;&amp;nbsp;&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=88&gt;
&lt;P align=right&gt;&lt;STRONG&gt;Spolu&lt;/STRONG&gt;&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=75&gt;
&lt;P align=right&gt;&lt;STRONG&gt;&amp;nbsp; 9 200&lt;/STRONG&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=402 colSpan=4&gt;Skladové položky po rozpočítaní obstarávacích nákladov vo výške&amp;nbsp;1000&amp;nbsp;EUR.&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=161&gt;
&lt;P align=left&gt;Piesok&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=66&gt;
&lt;P align=right&gt;&amp;nbsp;10 t&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=88&gt;
&lt;P align=right&gt;&amp;nbsp;554.438&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=75&gt;
&lt;P align=right&gt;&amp;nbsp; 5 544&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=161&gt;
&lt;P align=left&gt;Štrk hrubý&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=66&gt;
&lt;P align=right&gt;&amp;nbsp;5 t&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=88&gt;
&lt;P align=right&gt;&amp;nbsp;665.217&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=75&gt;
&lt;P align=right&gt;&amp;nbsp; 3 326&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=161&gt;
&lt;P align=left&gt;Štrk jemný&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=66&gt;
&lt;P align=right&gt;&amp;nbsp;2 t&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=88&gt;
&lt;P align=right&gt;&amp;nbsp;665.217&lt;/P&gt;&lt;/TD&gt;
&lt;TD width=75&gt;
&lt;P align=right&gt;&amp;nbsp; 1 330&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;
