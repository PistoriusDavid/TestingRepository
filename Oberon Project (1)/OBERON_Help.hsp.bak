                  <TopicKeyword BuildFlags="" Id="9029a568-b847-466d-aed1-a1b288d18162">
                    <Keyword m="2022-06-24T12:25:18.5319222Z">Príklad nastavenia a použitia cenových kategórií hostí</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="ed067137-33fa-4edd-aeda-bea77f18c769">
