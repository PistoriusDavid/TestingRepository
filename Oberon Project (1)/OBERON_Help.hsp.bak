                <TopicKeywords>
                  <TopicKeyword BuildFlags="" Id="57b0129d-2621-4c5e-a624-f4277bf52c63">
                    <Keyword m="2022-02-04T08:26:26.6327323Z">Licenčné práva - hlavná ponuka</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="645af981-ad2c-4e8f-a769-3459149d20b3">
                    <Keyword m="2024-01-09T09:00:51.563368Z">Trial licencia - licenčné práva</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="d4a205bd-3f16-47bc-ad04-120abb30fe3f">
                    <Keyword m="2017-07-03T09:00:50.9670267Z">Dočasná verzia OBERON-u</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="3d970ced-343e-4baf-a09c-08363979666d">
                    <Keyword m="2022-02-04T08:27:26.651254Z">Podrobnosti o aktuálnej licencii </Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="7b324f31-e1f6-4011-beeb-ddb469a92acc">
                    <Keyword m="2022-02-04T08:35:14.6883758Z">Dočasná trial licencia</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="b08c38eb-57e0-4ff5-b323-e001a0dcfba3">
                    <Keyword m="2022-02-04T08:35:21.6863043Z">Licencia trial</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="9180870c-740e-4ce5-955a-7d237d4016fe">
                    <Keyword m="2022-02-04T08:35:43.9990806Z">Odstránenie licencie</Keyword>
                  </TopicKeyword>
