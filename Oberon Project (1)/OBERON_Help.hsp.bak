                <TopicKeywords>
                  <TopicKeyword BuildFlags="" Id="216268dc-6127-43b6-a284-e5bc454cce47">
                    <Keyword m="2021-08-09T09:08:48.3527751Z">Výsledovka - tlač</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="b3d26418-e864-4851-bdef-6d9b613a508d">
                    <Keyword m="2021-08-09T09:08:38.4715466Z">Súvaha - tlač</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="0e4e55d3-a425-4115-a81c-52dfb021d79c">
                    <Keyword m="2021-08-09T09:09:03.0911983Z">Tlač hlavnej knihy</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="6415d24a-e310-4f49-99fc-7e11780f7511">
                    <Keyword m="2021-08-09T09:08:44.5762733Z">Účtovná závierka - tlač</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="0cad68cc-91b4-493f-9bf4-4805836422dd">
                    <Keyword m="2021-08-09T09:09:10.8997657Z">Hlavná kniha - tlač</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="3183a901-15ce-410c-b6f0-8065901f749a">
                    <Keyword m="2021-08-09T09:09:17.6605526Z">Účtovné knihy - tlač</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="5fc531cb-9c2c-4b72-88f4-c988ad8bce3a">
                    <Keyword m="2021-08-09T09:09:27.3421126Z">Tlač súvahy</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="81b6c0b6-0264-409b-baf0-ecb3e4897022">
