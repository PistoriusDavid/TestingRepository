                          <TopicKeyword BuildFlags="" Id="0fd35456-c74c-4996-a050-f617815649a1">
                            <Keyword m="2019-09-13T06:22:06.4769579Z">QeeR skener</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="f84c47a6-1e5b-4f06-82d6-3cb685f65a93">
                            <Keyword m="2021-05-12T08:03:42.4473519Z">QR kódy - QeeR skener</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="a6ce48c7-1ee0-45f7-b9cf-a5aff0fe8996">
                            <Keyword m="2021-05-12T08:03:24.5967837Z">Snímač QR kódov QeeR skener</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="75ba6a72-2f4d-4d1d-97ba-9695a575a1a4">
