                        <TopicKeywords>
                          <TopicKeyword BuildFlags="" Id="6ff5b343-fe53-4534-9a73-511a3bdb2abc">
                            <Keyword m="2021-05-27T13:02:55.6462023Z">Nastavenia programu - Používateľ - Sklad</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="0aff0146-c36d-4469-a1bf-601957fc3652">
                            <Keyword m="2021-05-27T13:03:07.8368262Z">Používateľ - Sklad - Nastavenia programu</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="a2025e8b-c4d0-4992-bfff-60a819b861d2">
                            <Keyword m="2022-03-02T14:26:04.3458544Z">Upozornenia - neuhradené pohľadávky</Keyword>
                          </TopicKeyword>
