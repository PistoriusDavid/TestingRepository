                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="a4bd23d3-0340-43fd-80e0-640f745b5593">
                    <Keyword m="2022-01-20T14:02:08.2440456Z">Dokument - príloha k dokladom a záznamom (pohľadávka, výdajka, reklamácia/servis...)</Keyword>
                  </TopicKeyword>
                </TopicKeywords>
