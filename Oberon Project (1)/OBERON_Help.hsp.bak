                        <TopicKeywords>
                          <TopicKeyword BuildFlags="" Id="2a69ab68-98a8-44c5-8259-e44869f468f7">
                            <Keyword m="2022-04-21T08:29:22.9835984Z">Manažér rezervačných kanálov Beds24 - nastavenie komunikácie s OBERON-om</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="bc84a8d6-3cd6-474a-a8d2-e564e67e677b">
