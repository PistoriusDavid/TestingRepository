                  </Topic>
                  <Topic Id="8a48a395-a1ba-47fb-b250-689f6df7e93e" Status="Complete" CreatedOn="2014-09-04T15:03:54.4010597Z" ModifiedOn="2022-11-21T10:27:08.580935Z" ModifiedBy="" PageTypeName="OBERON Standard.html" AutoIndex="true" HelpContextIds="" Name="Homebanking_Format_of_Exported_File" BuildFlags="">
                    <Title m="2021-08-04T09:23:51.6119038Z">Formáty exportovaných príkazov na úhradu</Title>
                    <ContentsTitle />
                    <Notes></Notes>
                    <CanonicalLink></CanonicalLink>
                    <TopicSections>
                      <TopicSection Name="BodyText">
                        <Content m="2022-10-27T07:09:32.2089372Z">&lt;P&gt;Táto téma &lt;EM&gt;Pomocníka&lt;/EM&gt; obsahuje &lt;STRONG&gt;prehľad formátov elektronických príkazov na úhradu&lt;/STRONG&gt; podporovaných systémom OBERON.&lt;/P&gt;
&lt;H2&gt;Základné informácie&lt;/H2&gt;
&lt;UL&gt;
&lt;LI&gt;Systém OBERON pracuje so&amp;nbsp;všeobecným formátom &lt;EM&gt;&lt;STRONG&gt;SEPA Credit Transfer (SCT)&lt;/STRONG&gt;&lt;/EM&gt;. 
&lt;LI&gt;Formát elektronického príkazu na úhradu vytvoreného v OBERON-e je možné nastaviť v sprievodcovi exportu príkazu do banky alebo priamo pri bankovom účte (v ponuke &lt;EM&gt;Firma,&lt;/EM&gt; &lt;A href="93ded66f-b7a6-40a8-89e0-bd501cd17bfc"&gt;Vlastné bankové účty&lt;/A&gt;&amp;nbsp;- pole&amp;nbsp;&lt;EM&gt;Typ príkazu na úhradu&lt;/EM&gt; (odporúčané nastavenie). &lt;/LI&gt;&lt;/UL&gt;
&lt;H2&gt;Podporované&amp;nbsp;formáty exportu&lt;/H2&gt;&lt;innovasys:widget type="Drop Down Section" layout="block"&gt;&lt;innovasys:widgetproperty layout="inline" name="Heading"&gt;Všeobecné formáty&lt;/innovasys:widgetproperty&gt; &lt;innovasys:widgetproperty layout="block" name="Content"&gt;&lt;innovasys:widget type="Drop Down Section" layout="block"&gt;&lt;innovasys:widgetproperty layout="inline" name="Heading"&gt;Všeobecný formát - [SEPA CREDIT TRANSFER - SCT]&lt;/innovasys:widgetproperty&gt; &lt;innovasys:widgetproperty layout="block" name="Content"&gt;
&lt;P&gt;SEPA úhrada (SEPA Credit Transfer) je bezhotovostný prevod v eurách v rámci členských krajín &lt;EM&gt;Európskej únie&lt;/EM&gt;, ktorý zadáva banke platiteľ na základe platobného príkazu prostredníctvom svojej banky.&lt;/P&gt;
&lt;P&gt;---položka príkazu&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;lt;CdtTrfTxInf&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp; &amp;lt;PmtId&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; InstrId&amp;gt;&lt;STRONG&gt;MCCT150113000001&lt;/STRONG&gt;&amp;lt;/InstrId&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;EndToEndId&amp;gt;&lt;STRONG&gt;REFERENCIA&lt;/STRONG&gt; &lt;STRONG&gt;PLATITELA&lt;/STRONG&gt;&amp;lt;/EndToEndId&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; /PmtId&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Amt&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; InstdAmt Ccy="EUR"&amp;gt;&lt;STRONG&gt;11.04&lt;/STRONG&gt;&amp;lt;/InstdAmt&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/Amt&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;lt;ChrgBr&amp;gt;&lt;STRONG&gt;SLEV&lt;/STRONG&gt;&amp;lt;/ChrgBr&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;lt;CdtrAgt&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; FinInstnId&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; BIC&amp;gt;&lt;STRONG&gt;TATRSKBX&lt;/STRONG&gt;&amp;lt;/BIC&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/FinInstnId&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/CdtrAgt&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Cdtr&amp;gt;&lt;BR&gt;&amp;lt;Nm&amp;gt;&lt;STRONG&gt;NAZOV PRIJEMCU&lt;/STRONG&gt;&amp;lt;/Nm&amp;gt;&lt;BR&gt;&amp;lt;/Cdtr&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;CdtrAcct&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Id&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;IBAN&amp;gt;&lt;STRONG&gt;SK8011000000002900000013&lt;/STRONG&gt;&amp;lt;/IBAN&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; /Id&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;/CdtrAcct&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;RmtInf&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Ustrd&amp;gt;&lt;STRONG&gt;INFORMACIA PRE PRIJEMCU&lt;/STRONG&gt;&amp;lt;/Ustrd&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;/RmtInf&amp;gt;&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;/CdtTrfTxInf&amp;gt;&lt;BR&gt;m_XmlData.AppendLine("&amp;lt;?xml version=""1.0"" encoding=""UTF-8""?&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;Document&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;Document xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""&lt;BR&gt;xmlns=""urn:iso:std:iso:20022:tech:xsd&lt;BR&gt;:pain.001.001.03"" xsi:schemaLocation=""urn:iso:std:iso:20022:tech:xsd:pain.001.001.03 pain.001.001.03.xsd""&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("CstmrCdtTrfInitn&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("GrpHdr&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("MsgId&amp;gt;BATCH ID pain001&amp;lt;/MsgId&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("CreDtTm&amp;gt;&amp;lt;/CreDtTm&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; 'm_XmlData.AppendLine("Authstn&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; 'm_XmlData.AppendLine("Prtry&amp;gt;BATCH&amp;lt;/Prtry&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; 'm_XmlData.AppendLine("/Authstn&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("NbOfTxs&amp;gt;&amp;lt;/NbOfTxs&amp;gt;")&lt;/P&gt;
&lt;P&gt;m_XmlData.AppendLine("CtrlSum&amp;gt;&amp;lt;/CtrlSum&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("InitgPty&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("Nm&amp;gt;&amp;lt;/Nm&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("PstlAdr&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("Ctry&amp;gt;SK&amp;lt;/Ctry&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("/PstlAdr&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("/InitgPty&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine(";/GrpHdr&amp;gt;")&lt;BR&gt;--- jeden príkaz&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("PmtInf&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("PmtInfId&amp;gt;&amp;lt;/PmtInfId&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("PmtMtd&amp;gt;TRF&amp;lt;/PmtMtd&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("BtchBookg&amp;gt;true&amp;lt;/BtchBookg&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("NbOfTxs&amp;gt;&amp;lt;/NbOfTxs&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("CtrlSum&amp;gt;&amp;lt;/CtrlSum&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("PmtTpInf&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("InstrPrty&amp;gt;NORM&amp;lt;/InstrPrty&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;SvcLvl&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;Cd&amp;gt;SEPA&amp;lt;/Cd&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;/SvcLvl&amp;gt;")&lt;BR&gt;m_XmlData.AppendLine("&amp;lt;/PmtTpInf&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;ReqdExctnDt&amp;gt;&amp;lt;/ReqdExctnDt&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine(" &amp;lt;Dbtr&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;Nm&amp;gt;&amp;lt;/Nm&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;PstlAdr&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;Ctry&amp;gt;SK&amp;lt;/Ctry&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;lt;/PstlAdr&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;/Dbtr&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;DbtrAcct&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine(" &amp;lt;Id&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;IBAN&amp;gt;&amp;lt;/IBAN&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine(" &amp;lt;/Id&amp;gt;")&lt;BR&gt;m_XmlData.AppendLine(" &amp;lt;Ccy&amp;gt;EUR&amp;lt;/Ccy&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine(" &amp;lt;/DbtrAcct&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine(" &amp;lt;DbtrAgt&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;FinInstnId&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;BIC&amp;gt;&amp;lt;/BIC&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine(" &amp;lt;/FinInstnId&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;/DbtrAgt&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;ChrgBr&amp;gt;SLEV&amp;lt;/ChrgBr&amp;gt;")&lt;BR&gt;&amp;nbsp;--- tu idú položky príkazu&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;/PmtInf&amp;gt;")&lt;BR&gt;---- sem idú položky&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;nbsp; &amp;lt;/CstmrCdtTrfInitn&amp;gt;")&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; m_XmlData.AppendLine("&amp;lt;/Document&amp;gt;")&lt;/P&gt;&lt;/innovasys:widgetproperty&gt;&lt;/innovasys:widget&gt;&lt;/innovasys:widgetproperty&gt;&lt;/innovasys:widget&gt;&lt;innovasys:widgetproperty layout="block" name="Content"&gt;&lt;/innovasys:widgetproperty&gt;</Content>
                      </TopicSection>
