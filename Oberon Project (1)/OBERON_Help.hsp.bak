                      </TopicLink>
                      <TopicLink BuildFlags="" Id="a8379d43-2b19-41fb-a42b-783990675326" CategoryId="" TopicLinkCategorySource="TopicCategory" Target="c4bb279e-a2ba-4690-83b9-efb2e11cc077">
                        <Title />
                        <Category />
                      </TopicLink>
                    </TopicLinks>
                    <TopicKeywords>
                      <TopicKeyword BuildFlags="" Id="a8132353-da35-48f1-be20-710d464bab0b">
                        <Keyword m="2023-10-12T12:07:43.1519473Z">Import údajov - XML komunikácia - sprievodca</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="e5543ef1-7deb-4af1-9ea3-b9cf4091c65a">
                        <Keyword m="2023-10-12T12:07:36.487415Z">Import dokladu - XML komunikácia - sprievodca</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="2d1f1a18-a20f-4dab-90fb-681d5af4e1ce">
                        <Keyword m="2023-10-12T12:07:51.5518812Z">XML komunikácia - manuálny import údajov - sprievodca</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="6e66dc69-e6fe-48a7-890c-4c0dcf90a5f3">
                        <Keyword m="2023-10-12T12:07:47.5525065Z">XML komunikácia - manuálny import dokladu - sprievodca</Keyword>
                      </TopicKeyword>
