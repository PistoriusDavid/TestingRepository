                  <Topic Id="d625d826-19da-443e-9c4b-9fd6d5a9c0bd" Status="Complete" CreatedOn="2014-09-11T11:09:12.6548325Z" ModifiedOn="2023-06-08T08:58:30.6704666Z" ModifiedBy="" PageTypeName="OBERON Standard.html" AutoIndex="true" HelpContextIds="" Name="Stock_Advanced_Recepture_Samples" BuildFlags="">
                    <Title m="2014-09-11T11:09:34.6500905Z">Príklady receptúr</Title>
                    <ContentsTitle />
                    <Notes></Notes>
                    <CanonicalLink></CanonicalLink>
                    <TopicSections>
                      <TopicSection Name="BodyText">
                        <Content m="2023-06-08T08:58:30.6704666Z">&lt;P&gt;V tejto téme &lt;EM&gt;Pomocníka&lt;/EM&gt; sú uvedené &lt;STRONG&gt;príklady receptúr&lt;/STRONG&gt; vytvorených v&amp;nbsp;module&amp;nbsp;&lt;A href="78d20602-4b59-4b31-9f0a-a04a1d376ec5"&gt;Skladová evidencia&lt;/A&gt;.&lt;/P&gt;&lt;innovasys:widget type="Drop Down Section" layout="block"&gt;&lt;innovasys:widgetproperty layout="inline" name="Heading"&gt;Príklad receptúry Vyprážaný bravčový rezeň&lt;/innovasys:widgetproperty&gt; &lt;innovasys:widgetproperty layout="block" name="Content"&gt;
&lt;H3&gt;Vyprážaný bravčový rezeň&lt;BR&gt;&lt;/H3&gt;
&lt;TABLE style="HEIGHT: 167px; WIDTH: 40.08%"&gt;
&lt;TBODY&gt;
