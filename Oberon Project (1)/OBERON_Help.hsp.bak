                      <TopicKeyword BuildFlags="" Id="6f855434-4cfa-4427-8677-201d14b4ef99">
                        <Keyword m="2022-12-15T09:50:19.3424645Z">OBERON Database - transport údajov</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="df443441-2bd9-4305-bf72-5f2b380e710b">
                        <Keyword m="2022-12-15T09:50:26.2796233Z">Priamy prístup do databázy - transport údajov</Keyword>
                      </TopicKeyword>
