                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="e011807c-4037-42bf-9629-7759eb7d5ccf">
                    <Keyword m="2022-01-25T13:56:00.5295383Z">Systémový používateľ</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="a3a1b47d-80a9-4633-b9a6-0e6c9ce6651d">
                    <Keyword m="2022-01-25T13:56:19.0988814Z">Podpis alebo pečiatka na faktúre - nastavenie</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="b8b816d6-fa0d-48f8-8950-7658e3e0b790">
                    <Keyword m="2015-10-23T08:57:31.9736328Z">Skupiny používateľov</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="d44e79d1-ccf4-46a4-ad14-41c4bd8166f0">
                    <Keyword m="2022-01-25T13:55:54.6327785Z">Používateľ - formulár</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="f2d08d9b-5a19-4f38-aa1c-3d7c129154a3">
