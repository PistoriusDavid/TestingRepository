                    <TopicKeywords>
                      <TopicKeyword BuildFlags="" Id="8df79304-0d95-4081-a3f8-979a29f83be0">
                        <Keyword m="2021-04-30T12:40:20.0521449Z">Registračné pokladnice v režime off-line - všeobecné informácie</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="1024adbc-6e06-4646-bf7f-5d62644ad48b">
                        <Keyword m="2021-04-30T12:40:51.3321958Z">PLU - definícia</Keyword>
                      </TopicKeyword>
                    </TopicKeywords>
