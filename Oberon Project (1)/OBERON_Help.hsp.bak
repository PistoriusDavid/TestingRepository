&lt;TD height=22 width="7.5%" colSpan=3 align=center&gt;&lt;STRONG&gt;600&amp;nbsp;€&lt;/STRONG&gt;&amp;nbsp;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD height=22 width="20%" align=left&gt;26&amp;nbsp;až&amp;nbsp;30&amp;nbsp;používateľov&lt;/TD&gt;
&lt;TD height=22 width="7.5%" colSpan=3 align=center&gt;&lt;STRONG&gt;700&amp;nbsp;€&lt;/STRONG&gt;&amp;nbsp;&lt;/TD&gt;&lt;/TR&gt;
