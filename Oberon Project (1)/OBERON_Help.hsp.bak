&lt;TR&gt;
&lt;TD bgColor=#fff2cc width="20%"&gt;&lt;STRONG&gt;Podpora&amp;nbsp;ďalších bánk&lt;/STRONG&gt;&lt;/TD&gt;
&lt;TD style="COLOR: rgb(0,0,0)" align=center&gt;&lt;SPAN&gt;&lt;SPAN&gt;&lt;IMG border=0 alt="" src="images/Forms/Menu/Form_menu_Cross.png"&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/TD&gt;
