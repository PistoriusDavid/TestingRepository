                    <TopicKeywords>
                      <TopicKeyword BuildFlags="" Id="4670ac18-1748-4b31-972e-7b4fd840f0ae">
                        <Keyword m="2022-12-08T08:42:39.1517919Z">Spôsob A - všeobecne o účtovaní skladu</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="0d358f09-2a02-4ddf-9718-781064af4eab">
                        <Keyword m="2022-12-08T08:42:45.2259792Z">Spôsob B - všeobecne o účtovaní skladu</Keyword>
                      </TopicKeyword>
