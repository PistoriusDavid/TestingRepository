                      </TopicLink>
                    </TopicLinks>
                    <TopicKeywords>
                      <TopicKeyword BuildFlags="" Id="bd804aae-fef1-4cd1-ab8c-ef31ef129ac5">
                        <Keyword m="2022-01-21T08:51:03.6721285Z">Atribúty - varianty skladovej karty - definovanie</Keyword>
                      </TopicKeyword>
