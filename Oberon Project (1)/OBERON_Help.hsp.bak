                      <TopicKeyword BuildFlags="" Id="685b8ae0-a368-4fc7-8610-7d8af7fa8e4b">
                        <Keyword m="2024-03-20T12:21:11.9128041Z">Elektronický podpis - vygenerovaný v OBERON-e</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="0a9fba3d-448f-4c7c-9cce-999f1335c807">
                        <Keyword m="2024-03-19T13:26:01.1720814Z">Používateľ - priradenie podpisového certifikátu</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="afd3f9a0-949d-4cf6-951d-54b009c30da1">
                        <Keyword m="2024-03-19T13:25:27.2637658Z">Podpisový certifikát - digitálny podpis vygenerovaný v OBERON-e</Keyword>
