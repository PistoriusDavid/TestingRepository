              </TopicLink>
            </TopicLinks>
            <TopicKeywords>
              <TopicKeyword BuildFlags="" Id="8880cc7e-8c7c-4109-a5c1-9dbc18c45691">
                <Keyword m="2022-11-21T12:42:59.9483602Z">Špecifický symbol - príkazy na úhradu</Keyword>
              </TopicKeyword>
              <TopicKeyword BuildFlags="" Id="57dcd42c-daf2-4738-906a-1c7e12ec2fea">
                <Keyword m="2022-11-21T12:43:08.3014661Z">Variabilný symbol - príkazy na úhradu</Keyword>
              </TopicKeyword>
              <TopicKeyword BuildFlags="" Id="b0861ff4-5d1f-43f0-941b-d34af8222eb3">
                <Keyword m="2022-11-21T12:43:13.8141953Z">Symboly platieb - príkazy na úhradu</Keyword>
              </TopicKeyword>
            </TopicKeywords>
