                    <Keyword m="2023-03-10T08:17:52.5020033Z">Dátum a čas vo fiškálnom zariadení</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="b1982d5e-38f1-483a-bf39-a9272569f5d8">
