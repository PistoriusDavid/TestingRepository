                  <TopicLink BuildFlags="" Id="fa37a628-f804-4d65-9802-30d0a918f688" CategoryId="" TopicLinkCategorySource="SpecificValue" Target="831d0b51-ffdf-4708-8afc-9d305d97e4d0">
                    <Title m="2022-07-07T09:59:20.3846896Z">Účtovná závierka peňažného denníka</Title>
                    <Category />
                  </TopicLink>
                </TopicLinks>
                <TopicKeywords>
                  <TopicKeyword BuildFlags="" Id="d2825c93-d7d8-4cf6-890e-3fa83a562a0c">
                    <Keyword m="2022-11-21T09:54:17.8706033Z">Denník - peňažný</Keyword>
                  </TopicKeyword>
