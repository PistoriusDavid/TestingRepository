                  <TopicKeyword BuildFlags="" Id="38fbdf74-013d-4d9a-9b31-1b6c8a5e552d">
                    <Keyword m="2023-04-14T11:18:23.5688927Z">Preddavková faktúra</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="f843249a-ddd9-4287-ab00-daa8b2ac1d83">
                    <Keyword m="2023-04-14T11:18:30.1125664Z">Predfaktúra</Keyword>
