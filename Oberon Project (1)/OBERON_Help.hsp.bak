      <TopicCategory Id="284aa99d-641b-4e6e-9a8c-f18cb520f374" AutoIndex="false">
        <Caption m="2014-10-10T11:13:08.5393093Z">MsgBox</Caption>
        <ChildTopicCategories>
          <TopicCategory Id="ede70ace-9a02-4e87-bca8-512afef58f4a" AutoIndex="false">
            <Caption m="2014-10-10T11:13:29.4425049Z">AccDouble</Caption>
            <ChildTopicCategories />
            <Topics>
              <Topic Id="f68bd781-3b16-48e3-b1da-15dd4c450110" Status="Complete" CreatedOn="2014-10-13T06:24:34.0116081Z" ModifiedOn="2024-06-19T10:41:01.8858859Z" ModifiedBy="" PageTypeName="OBERON Standard.html" AutoIndex="true" HelpContextIds="39010" Name="MsgBox_AccDouble_LicencePrivileges" BuildFlags="">
                <Title m="2014-10-13T06:26:18.5005845Z">Nedostatočné licenčné práva na vykonanie tejto činnosti</Title>
                <ContentsTitle />
                <Notes></Notes>
                <CanonicalLink></CanonicalLink>
                <TopicSections>
                  <TopicSection Name="BodyText">
                    <Content m="2024-06-19T10:41:01.8858859Z">&lt;P&gt;Táto téma &lt;EM&gt;Pomocníka&lt;/EM&gt; obsahuje &lt;STRONG&gt;informácie o dialógovom okne týkajúcom sa informácie o nedostatočných licenčných právach v module &lt;EM&gt;Podvojné účtovníctvo&lt;/EM&gt;&lt;/STRONG&gt;.&lt;/P&gt;
&lt;H2&gt;Základné informácie&lt;/H2&gt;
&lt;UL&gt;
&lt;LI&gt;Na používanie&amp;nbsp;modulu&amp;nbsp;&lt;A href="49dd3167-870a-4fdf-b631-d4f692f1ed72"&gt;Podvojné účtovníctvo&lt;/A&gt; je potrebné zakúpiť a&amp;nbsp;aktivovať licenciu. Bez zakúpenej licencie je možné &lt;STRONG&gt;vykonať len 100 zápisov do účtovného denníka v&amp;nbsp;jednom účtovnom období&lt;/STRONG&gt;. 
&lt;LI&gt;Po&amp;nbsp;&lt;A href="49208c26-7930-4363-9fab-977662e2e8cc"&gt;realizácii objednávky licencie&lt;/A&gt; je&amp;nbsp;systém OBERON&amp;nbsp;&lt;STRONG&gt;plne&amp;nbsp;funkčný v&amp;nbsp;rámci objednaného typu licencie počas 15 dní&amp;nbsp;od objednania licencie&lt;/STRONG&gt; &lt;STRONG&gt;(trial licencia)&lt;/STRONG&gt;.&amp;nbsp;Ak po uplynutí tohto času nedôjde k úhrade poplatku za&amp;nbsp;licenciu,&amp;nbsp;vybrané funkcie a počet zápisov v niektorých evidenciách sa znovu automaticky&amp;nbsp;&lt;A href="644b0685-defe-4ce5-b3cd-e731b5eff299"&gt;obmedzia&lt;/A&gt;.&amp;nbsp;&lt;A href="efb93a2c-e449-4770-88ba-0fe999e90ccd"&gt;Úhradou poplatku za licenciu a jej aktivovaním&lt;/A&gt;&amp;nbsp;sa obmedzenia zrušia -&amp;nbsp;so softvérom bude možné pracovať plnohodnotne. &lt;/LI&gt;&lt;/UL&gt;&lt;innovasys:widget type="Caution Box" layout="block"&gt;&lt;innovasys:widgetproperty layout="block" name="Content"&gt;&lt;STRONG&gt;Upozornenie:&lt;/STRONG&gt; V jednom účtovnom období (od 1.1. do 31.12.)&amp;nbsp;je možné pracovať &lt;STRONG style="COLOR: rgb(255,0,0)"&gt;v rámci&amp;nbsp;tzv.&amp;nbsp;trial licencie len raz&lt;/STRONG&gt;. Podrobné informácie o fungovaní trial licencie získate v&amp;nbsp;&lt;A href="40c83e5f-22aa-4ba5-b4c1-35938f90fac2"&gt;Obchodných podmienkach&lt;/A&gt;.&lt;/innovasys:widgetproperty&gt;&lt;/innovasys:widget&gt;</Content>
                  </TopicSection>
                </TopicSections>
                <TopicLinks>
                  <TopicLink BuildFlags="" Id="ccc87f2a-f63f-415a-9cf6-e6ce82c18df8" CategoryId="" TopicLinkCategorySource="SpecificValue" Target="95d188df-c149-46a9-8474-4d9493f2ad41">
                    <Title />
                    <Category />
                  </TopicLink>
                  <TopicLink BuildFlags="" Id="d6646a97-7967-4e30-a8c1-b0067c16ed55" CategoryId="" TopicLinkCategorySource="SpecificValue" Target="644b0685-defe-4ce5-b3cd-e731b5eff299">
                    <Title />
                    <Category />
                  </TopicLink>
                  <TopicLink BuildFlags="" Id="c2e6868e-77a0-4a18-adf5-39e3e991e142" CategoryId="" TopicLinkCategorySource="SpecificValue" Target="efb93a2c-e449-4770-88ba-0fe999e90ccd">
                    <Title />
                    <Category />
                  </TopicLink>
                </TopicLinks>
                <TopicKeywords>
                  <TopicKeyword BuildFlags="" Id="e354e891-2af8-4e50-92ef-dd5044fe65b3">
                    <Keyword m="2023-07-18T11:30:51.894245Z">Chybové hlásenie - nedostatočné licenčné práva Podvojné účtovníctvo</Keyword>
                  </TopicKeyword>
                </TopicKeywords>
