&lt;P&gt;&lt;B&gt;Čisté množstvo&lt;/B&gt;&lt;/P&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;B&gt;MJ&lt;/B&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=136&gt;0029&lt;/TD&gt;
&lt;TD width=130&gt;Bravčové karé&lt;/TD&gt;
&lt;TD width=127&gt;1,55&lt;/TD&gt;
&lt;TD width=139&gt;1,55&lt;/TD&gt;
&lt;TD&gt;kg&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=136&gt;0007&lt;/TD&gt;
&lt;TD width=130&gt;Soľ&lt;/TD&gt;
&lt;TD width=127&gt;30&lt;/TD&gt;
&lt;TD width=139&gt;30&lt;/TD&gt;
&lt;TD&gt;g&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=136&gt;0010&lt;/TD&gt;
&lt;TD width=130&gt;Olej&lt;/TD&gt;
&lt;TD width=127&gt;0,30&lt;/TD&gt;
&lt;TD width=139&gt;0,30&lt;/TD&gt;
