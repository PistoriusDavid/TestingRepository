                <TopicKeywords>
                  <TopicKeyword BuildFlags="" Id="8228d1e2-86ac-433a-97a3-6105edf57e82">
                    <Keyword m="2021-08-31T07:08:44.7435771Z">Cudzie meny - vytvorenie faktúry</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="293a08b5-7644-48f2-b0f9-10ed25892355">
                    <Keyword m="2021-08-31T07:21:24.814366Z">Faktúra v cudzej mene</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="107e3b44-a647-4385-887c-b817cc7ec229">
                    <Keyword m="2022-03-02T13:51:25.0916681Z">Faktúra - cudzia mena</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="023e8c15-1221-4cd8-b0e7-a5b5312f0c56">
                    <Keyword m="2022-03-03T10:28:36.0857948Z">Cudzia mena - vytvorenie faktúry</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="55837337-bfc6-4cdc-9b5d-b2ab351fb631">
                    <Keyword m="2022-03-03T10:28:48.8314568Z">Vystavenie faktúry v cudzej mene</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="4f42e42f-a7ee-484c-b5bc-7c285ee07512">
