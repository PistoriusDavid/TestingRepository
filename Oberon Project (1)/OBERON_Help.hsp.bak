                  <TopicKeyword BuildFlags="" Id="618462d2-68a6-4ff6-8155-08de7e577318">
                    <Keyword m="2021-03-30T11:22:18.7631767Z">Export údajov v OBERON-e - prehľad možností</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="af9340d9-0924-4d0d-b836-6eae5290948c">
                    <Keyword m="2021-03-30T11:22:28.467526Z">Import údajov v OBERON-e - prehľad možností</Keyword>
                  </TopicKeyword>
