              <Topic Id="4a759bbe-5765-4604-8d75-adbdf2ac191e" Status="Complete" CreatedOn="2022-02-21T07:27:26.7433614Z" ModifiedOn="2025-06-05T09:06:31.1317592Z" ModifiedBy="" PageTypeName="OBERON Standard.html" AutoIndex="true" HelpContextIds="" Name="Help_Help" BuildFlags="">
                <Title m="2025-06-05T09:05:28.7002597Z">Pomocník - obsah</Title>
                <ContentsTitle />
                <Notes></Notes>
                <CanonicalLink></CanonicalLink>
                <TopicSections>
                  <TopicSection Name="BodyText">
                    <Content m="2025-06-05T09:06:31.1317592Z">&lt;P&gt;Táto téma &lt;EM&gt;Pomocníka&lt;/EM&gt;&amp;nbsp;je venovaná&amp;nbsp;položke&amp;nbsp;&lt;EM&gt;Pomocník - obsah&lt;/EM&gt; v ponuke&amp;nbsp;&lt;EM&gt;Pomocník&lt;/EM&gt; programu &lt;EM&gt;OBERON - Agenda firmy&lt;/EM&gt;.&lt;/P&gt;
&lt;H2&gt;Základné informácie&lt;/H2&gt;
&lt;UL&gt;
&lt;LI&gt;Výberom položky sa&amp;nbsp;otvorí&amp;nbsp;&lt;EM&gt;Pomocník OBERON&lt;/EM&gt;, ktorý predstavuje&amp;nbsp;&lt;STRONG&gt;štandardnú dokumentáciu&lt;/STRONG&gt; systému OBERON. Obsahuje tak informácie &lt;STRONG&gt;pre bežných&amp;nbsp;používateľov, ako aj základné&amp;nbsp;informácie&lt;/STRONG&gt; pre servisných technikov, systémových integrátorov či&amp;nbsp;vývojárov. 
&lt;LI&gt;Dokumentáciu tvorí elektronická príručka vo formáte&amp;nbsp;štandardného &lt;EM&gt;Windows Pomocníka&lt;/EM&gt; (súbor OBERON.chm), ktorá je súčasťou štandardnej inštalácie. Popri tejto príručke&amp;nbsp;sú k dispozícii&amp;nbsp;aj ďalšie verzie &lt;EM&gt;Pomocníka OBERON&lt;/EM&gt;: 
&lt;UL&gt;
&lt;LI&gt;&lt;A href="https://exalogic.sk/help/oberon/index.html#OBERON_Info.html" target=_blank&gt;Pomocník OBERON on-line&lt;/A&gt;, 
&lt;LI&gt;&lt;EM&gt;Pomocník OBERON&lt;/EM&gt; vo formáte PDF - umožňuje vytlačenie&amp;nbsp;&lt;EM&gt;Pomocníka&lt;/EM&gt;, teda&amp;nbsp;zostavenie tlačenej&amp;nbsp;príručky. V prípade záujmu je možné &lt;EM&gt;Pomocníka&lt;/EM&gt; vo formáte PDF odoslať elektronickou poštou. &lt;/LI&gt;&lt;/UL&gt;
&lt;LI&gt;Okrem štandardného &lt;EM&gt;Pomocníka OBERON&lt;/EM&gt;&amp;nbsp;existuje aj&amp;nbsp;&lt;A href="519bcf42-f3e7-48c1-98a9-02a5784576f9"&gt;špecializovaná dokumentácia&lt;/A&gt; určená výhradne pre servisných technikov, systémových integrátorov, vývojárov&amp;nbsp;a&amp;nbsp;pod. &lt;/LI&gt;&lt;/UL&gt;&lt;innovasys:widget type="Note Box" layout="block"&gt;&lt;innovasys:widgetproperty layout="block" name="Content"&gt;Ďalšie informácie získate v téme&amp;nbsp;&lt;A href="8c0e0dd3-ce14-410b-9a1c-76b92585e960" style="auto-update-caption: true"&gt;Pomocník OBERON&lt;/A&gt;.&lt;/innovasys:widgetproperty&gt;&lt;/innovasys:widget&gt;</Content>
                  </TopicSection>
                </TopicSections>
                <TopicLinks>
                  <TopicLink BuildFlags="" Id="b67ce8f2-cdb9-4baa-a707-3ab02e734163" CategoryId="" TopicLinkCategorySource="TargetItemCategory" Target="8c0e0dd3-ce14-410b-9a1c-76b92585e960">
