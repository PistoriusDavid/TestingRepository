                    <TopicKeywords>
                      <TopicKeyword BuildFlags="" Id="067c8798-fc62-44cb-b149-d96c15f06517">
                        <Keyword m="2023-10-12T10:41:50.0726647Z">XML komunikácia - nastavenia - formulár</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="2a401e65-322d-4c8c-a18c-b9cca86af361">
                        <Keyword m="2023-10-12T10:41:41.3916976Z">Nastavenie XML komunikácie - formulár</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="c685b0c4-72a6-431f-afd1-5a52f647edbd">
                        <Keyword m="2022-02-14T13:21:00.1297515Z">Transformačné šablóny - výber</Keyword>
                      </TopicKeyword>
