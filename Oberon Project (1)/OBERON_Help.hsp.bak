                <TopicKeywords>
                  <TopicKeyword BuildFlags="" Id="80b1ef8d-c189-4f62-a908-0be46941f9c7">
                    <Keyword m="2023-04-13T12:26:52.9274811Z">Peňažný denník - zaúčtovanie úhrady pohľadávky</Keyword>
                  </TopicKeyword>
                </TopicKeywords>
