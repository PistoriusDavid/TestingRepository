              <TopicLink BuildFlags="" Id="fec3ccc3-3d2b-4dd1-9c0a-4f953625b494" CategoryId="" TopicLinkCategorySource="SpecificValue" Target="45c3e766-c948-449b-9292-afacb10df9bc">
                <Title m="2024-10-04T10:10:28.4548998Z">Podvojné účtovníctvom - základné možnosti</Title>
                <Category />
              </TopicLink>
              <TopicLink BuildFlags="" Id="6fbe484a-97c5-4aa8-a25e-7b97a57789ed" CategoryId="" TopicLinkCategorySource="SpecificValue" Target="98f3fbbd-4456-432c-9318-8f9c9a7d933e">
                <Title m="2024-10-04T10:11:02.4853076Z">Jednoduché účtovníctvo - základné možnosti</Title>
                <Category />
              </TopicLink>
