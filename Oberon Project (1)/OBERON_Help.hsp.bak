                    <Keyword m="2021-08-24T07:17:55.2177484Z">Zápis staršieho pokladničého dokladu do peňažného denníka</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="985b915a-b667-499e-9c71-0fde47b4a47f">
                    <Keyword m="2021-08-24T07:18:21.2805096Z">Peňažný denník - zápis staršieho pokladničného dokladu</Keyword>
                  </TopicKeyword>
                </TopicKeywords>
