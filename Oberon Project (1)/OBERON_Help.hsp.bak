                  <Topic Id="54a1321c-d4a6-43cf-8577-376a3f38f28c" Status="Complete" CreatedOn="2022-05-02T08:06:26.5281576Z" ModifiedOn="2024-11-11T10:20:07.6746545Z" ModifiedBy="" PageTypeName="OBERON Standard.html" AutoIndex="true" HelpContextIds="" Name="Stock_Advanced_Sets_Examples" BuildFlags="">
                    <Title m="2022-05-02T08:07:06.1353919Z">Príklady sád</Title>
                    <ContentsTitle />
                    <Notes></Notes>
                    <CanonicalLink></CanonicalLink>
                    <TopicSections>
                      <TopicSection Name="BodyText">
                        <Content m="2024-11-11T10:20:07.6746545Z">&lt;P&gt;V tejto téme &lt;EM&gt;Pomocníka&lt;/EM&gt; sú uvedené &lt;STRONG&gt;príklady skladových kariet&amp;nbsp;&lt;/STRONG&gt;&lt;A href="8deac9fe-9864-41e8-aaa3-02257c241d78"&gt;typu sada&lt;/A&gt; v module&amp;nbsp;&lt;A href="78d20602-4b59-4b31-9f0a-a04a1d376ec5"&gt;Skladová evidencia&lt;/A&gt; systému OBERON. Viac informácií o&amp;nbsp;typoch skladových kariet je možné získať v&amp;nbsp;téme&amp;nbsp;&lt;A href="8deac9fe-9864-41e8-aaa3-02257c241d78" style="auto-update-caption: true"&gt;Typy skladových kariet&lt;/A&gt;.&lt;/P&gt;&lt;innovasys:widget type="Drop Down Section" layout="block"&gt;&lt;innovasys:widgetproperty layout="inline" name="Heading"&gt;Príklad sady &lt;EM&gt;Počítačová zostava HP PAVILION&lt;/EM&gt;&lt;/innovasys:widgetproperty&gt; &lt;innovasys:widgetproperty layout="block" name="Content"&gt;
&lt;P&gt;V príklade je použitá skladová karta&amp;nbsp;&lt;A href="8deac9fe-9864-41e8-aaa3-02257c241d78"&gt;typu sada&lt;/A&gt;&amp;nbsp;&lt;EM&gt;Počítačová zostava HP PAVILION.&lt;/EM&gt; Na jednotlivé položky sady bola uplatnená zľava 5&amp;nbsp;% z cenovej hladiny 1.&lt;/P&gt;
&lt;P&gt;&amp;nbsp;&lt;/P&gt;
&lt;P&gt;&lt;STRONG&gt;Skladová karta typu sada&amp;nbsp;&lt;EM&gt;Počítačová zostava HP PAVILION&lt;/EM&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/STRONG&gt;&lt;/P&gt;
