                <Title m="2014-09-05T14:52:08.0224545Z">Koniec</Title>
                <ContentsTitle />
                <Notes></Notes>
                <CanonicalLink></CanonicalLink>
                <TopicSections>
                  <TopicSection Name="BodyText">
                    <Content m="2021-07-06T09:09:15.4392228Z">&lt;P&gt;Výberom položky&amp;nbsp;&lt;EM&gt;Koniec&lt;/EM&gt; v ponuke &lt;EM&gt;OBERON&lt;/EM&gt; programu &lt;EM&gt;OBERON - Agenda firmy&lt;/EM&gt; &lt;STRONG&gt;sa tento&lt;/STRONG&gt; &lt;STRONG&gt;program ukončí&lt;/STRONG&gt;.&amp;nbsp;Pred ukončením programu sa&amp;nbsp;odporúča zatvoriť všetky otvorené formuláre.&lt;/P&gt;</Content>
                  </TopicSection>
