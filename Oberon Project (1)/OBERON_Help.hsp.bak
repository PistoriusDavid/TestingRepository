&lt;TD class=CZ height=23 width=197&gt;VÚB homebanking - tuzemsko&lt;/TD&gt;
&lt;TD class=CZ height=23 align=left&gt;XML&lt;/TD&gt;&lt;/TR&gt;
&lt;TR class=CZ&gt;
&lt;TD class=CZ width=197&gt;VÚB internetbanking&lt;/TD&gt;
