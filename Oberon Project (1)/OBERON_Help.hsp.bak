                <TopicKeywords>
                  <TopicKeyword BuildFlags="" Id="f816e2ed-375c-4542-9077-e611f06d9273">
                    <Keyword m="2021-05-17T12:07:15.3993053Z">Cenovky - tlač</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="8d063cf2-f2d7-4957-98e4-6369e9528ec8">
                    <Keyword m="2021-05-17T12:07:49.8368151Z">QR kód za čiarový kód</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="af167cc1-db24-4cff-b351-56efd6f71e0c">
