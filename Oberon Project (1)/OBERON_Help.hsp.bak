          <Topic Id="10acb2be-830f-4012-930c-ead0f6ad67ab" Status="Complete" CreatedOn="2014-09-05T08:44:58.53744Z" ModifiedOn="2023-10-05T09:22:08.0618423Z" ModifiedBy="" PageTypeName="OBERON Standard (No Footer).html" AutoIndex="true" HelpContextIds="" Name="FAQ_List_Base" BuildFlags="">
            <Title m="2015-01-14T08:55:10.6738281Z">FAQ - najčastejšie kladené otázky </Title>
            <ContentsTitle />
            <Notes></Notes>
            <CanonicalLink></CanonicalLink>
            <TopicSections>
              <TopicSection Name="BodyText">
                <Content m="2023-07-07T11:33:28.2114722Z">&lt;H2&gt;Okruhy otázok:&lt;/H2&gt;
&lt;UL&gt;
&lt;LI&gt;&lt;A href="0102a1cb-17a4-458c-b1c0-c65421094d53"&gt;Všeobecne o systéme OBERON&lt;/A&gt; 
&lt;LI&gt;&lt;A href="d4439616-44d5-4cf5-90e1-1c88bed6e3fa"&gt;Podvojné účtovníctvo&lt;/A&gt; 
&lt;LI&gt;&lt;A href="25fb750b-585a-4fdc-8664-4c28a9dc0716"&gt;Jednoduché účtovníctvo&lt;/A&gt; 
&lt;LI&gt;&lt;A href="33c816b4-c995-4c87-ab81-0d510c74e2dc"&gt;Fakturácia&lt;/A&gt; 
&lt;LI&gt;&lt;A href="23a663d0-aec8-4d6c-b59b-9d494caf1b07"&gt;Skladová evidencia&lt;/A&gt; 
&lt;LI&gt;&lt;A href="3b53a829-6b6a-4645-8789-564ee19f2ce5"&gt;Pokladnica OBERON&lt;/A&gt; 
&lt;LI&gt;&lt;A href="63c066db-5faa-4da8-a1a9-f865d6811d53"&gt;Mzdy a dochádzka&lt;/A&gt; 
&lt;LI&gt;&lt;A href="e2e35ad7-8438-41a1-a1f7-9031d70436d7"&gt;Hotelová recepcia&lt;/A&gt; 
&lt;LI&gt;&lt;A href="18f83ac5-bb79-4de5-981b-2f6085889601"&gt;CRM a registratúra&lt;/A&gt; 
&lt;LI&gt;&lt;A href="fa6e852d-ad5e-4db6-9af3-5012cbf4c98b"&gt;OBERON Automation Center (OAC)&lt;/A&gt; &lt;/LI&gt;&lt;/UL&gt;</Content>
              </TopicSection>
