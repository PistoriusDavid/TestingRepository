                <TopicKeywords>
                  <TopicKeyword BuildFlags="" Id="2c322695-2f85-4f41-8c2e-dff22987c394">
                    <Keyword m="2015-04-15T07:12:35.8134765Z">Zmluvná rezervácia</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="9d8335cd-3ea1-426e-ae43-3d6f8cc53d29">
                    <Keyword m="2015-04-15T07:13:19.6523437Z">Rezervácia pre cestovnú kanceláriu</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="52a2f837-6bf9-4110-95b2-fcd8ed7a1d84">
                    <Keyword m="2022-06-06T07:12:54.6379375Z">Časová platnosť zmluvnej rezervácie</Keyword>
                  </TopicKeyword>
                </TopicKeywords>
