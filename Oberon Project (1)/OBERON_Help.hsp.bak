                      <TopicKeyword BuildFlags="" Id="abb64194-9b24-4df0-8e0e-d0de991317c6">
                        <Keyword m="2022-11-30T10:19:37.9415382Z">GPrinter 80250 Plus - tlačiareň</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="e29a7577-d12c-43ca-9d93-4f91988570f8">
                        <Keyword m="2022-12-15T08:16:35.9577211Z">GPrinter 80250 Plus - zápis nastavení do fiškálneho zariadenia</Keyword>
