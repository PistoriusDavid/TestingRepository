&lt;TD height=15 width="11%" align=right&gt;&lt;/TD&gt;
&lt;TD height=15 width="13%" align=right&gt;&lt;/TD&gt;
&lt;TD height=15 width="11%" align=right&gt;&lt;B&gt;343&lt;/B&gt;&lt;/TD&gt;
&lt;TD height=15 width="12%" align=right&gt;158,33&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD height=15 width="17%" align=left&gt;Pokl.-Príjem&lt;/TD&gt;
&lt;TD height=15 width="34%" align=left&gt;Tržby - tovar&lt;/TD&gt;
&lt;TD height=15 width="11%" align=right&gt;&lt;/TD&gt;
