&lt;TD&gt;&lt;B&gt;Názov&lt;/B&gt;&lt;/TD&gt;
&lt;TD width=147&gt;&lt;B&gt;Hrubé množstvo&lt;/B&gt;&lt;/TD&gt;
&lt;TD width=96&gt;&lt;B&gt;Čisté množstvo&lt;/B&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;B&gt;MJ&lt;/B&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=122&gt;2552&lt;/TD&gt;
&lt;TD&gt;Pivo svetlé 12° sklad&lt;/TD&gt;
&lt;TD width=147&gt;0,5&lt;/TD&gt;
&lt;TD width=96&gt;0,5&lt;/TD&gt;
&lt;TD&gt;l&lt;/TD&gt;&lt;/TR&gt;&lt;/TBODY&gt;&lt;/TABLE&gt;
&lt;H3&gt;Pivo svetlé 12°, 0,3 l čapované&lt;BR&gt;&lt;/H3&gt;
&lt;TABLE style="WIDTH: 40.08%"&gt;
&lt;TBODY&gt;
&lt;TR&gt;
&lt;TD bgColor=#d9e1f2 width=122&gt;&lt;B&gt;Zloženie receptúry&lt;/B&gt;&lt;/TD&gt;
&lt;TD width=130&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;/TD&gt;
&lt;TD width=139&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=200&gt;&lt;FONT size=2&gt;&lt;FONT size=2&gt;&lt;STRONG&gt;Pivo svetlé 12°, 0,3&amp;nbsp;l čapované&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/TD&gt;
&lt;TD width=130&gt;
&lt;P&gt;&lt;B&gt;Počet porcií: 1&lt;/B&gt;&lt;/P&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;/TD&gt;
&lt;TD width=139&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=122&gt;&lt;B&gt;Číslo&lt;/B&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;B&gt;Názov&lt;/B&gt;&lt;/TD&gt;
&lt;TD width=147&gt;&lt;B&gt;Hrubé množstvo&lt;/B&gt;&lt;/TD&gt;
&lt;TD width=96&gt;&lt;B&gt;Čisté množstvo&lt;/B&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;B&gt;MJ&lt;/B&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=122&gt;2552&lt;/TD&gt;
&lt;TD&gt;Pivo svetlé 12° sklad&lt;/TD&gt;
&lt;TD width=147&gt;0,3&lt;/TD&gt;
&lt;TD width=96&gt;0,3&lt;/TD&gt;
&lt;TD&gt;l&lt;/TD&gt;&lt;/TR&gt;&lt;/TBODY&gt;&lt;/TABLE&gt;
&lt;H3&gt;Rezané pivo 12°, 0,5 l&lt;BR&gt;&lt;/H3&gt;
&lt;TABLE style="WIDTH: 40.08%"&gt;
&lt;TBODY&gt;
&lt;TR&gt;
&lt;TD bgColor=#d9e1f2 width=122&gt;&lt;B&gt;Zloženie receptúry&lt;/B&gt;&lt;/TD&gt;
&lt;TD width=130&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;/TD&gt;
&lt;TD width=139&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=200&gt;&lt;FONT size=2&gt;&lt;FONT size=2&gt;&lt;STRONG&gt;Rezané pivo 12°, 0,5 l&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/TD&gt;
&lt;TD width=130&gt;
&lt;P&gt;&lt;B&gt;Počet porcií: 1&lt;/B&gt;&lt;/P&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;/TD&gt;
&lt;TD width=139&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;/TD&gt;&lt;/TR&gt;
&lt;TR&gt;
&lt;TD width=122&gt;&lt;B&gt;Číslo&lt;/B&gt;&lt;/TD&gt;
&lt;TD&gt;&lt;B&gt;Názov&lt;/B&gt;&lt;/TD&gt;
&lt;TD width=147&gt;&lt;B&gt;Hrubé množstvo&lt;/B&gt;&lt;/TD&gt;
