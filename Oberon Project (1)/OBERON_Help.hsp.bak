                <TopicKeywords>
                  <TopicKeyword BuildFlags="" Id="7241e2e2-cbdf-427c-b94a-c494f8dab54c">
                    <Keyword m="2014-12-23T07:53:01.2802734Z">Typy dokladov v účtovnom denníku</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="f94a3b8d-6d89-4fb0-b370-2cefdace114b">
