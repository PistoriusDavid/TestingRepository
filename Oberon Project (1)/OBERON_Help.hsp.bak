                  </TopicLink>
                </TopicLinks>
                <TopicKeywords>
                  <TopicKeyword BuildFlags="" Id="f41e4070-020d-4b65-9660-7de94ccbb3f9">
                    <Keyword m="2021-06-09T12:53:43.6906233Z">Kalendár v OBERON-e</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="3a01f7e3-9a92-42c0-adb1-07f01736cbee">
                    <Keyword m="2024-08-07T07:27:09.0586579Z">Ovládanie ročného kalendára</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="11e7df62-1c09-4052-9742-fc259875bc59">
                    <Keyword m="2024-08-07T07:27:17.3270434Z">Ročný kalendár - ovládanie</Keyword>
                  </TopicKeyword>
                </TopicKeywords>
