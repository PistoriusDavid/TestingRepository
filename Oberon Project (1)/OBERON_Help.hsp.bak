                        <TopicKeywords>
                          <TopicKeyword BuildFlags="" Id="fe87a3fb-fabb-416e-b073-3e145c13e2f7">
                            <Keyword m="2021-04-07T12:28:44.2753172Z">FT4000B VAROS eKasa</Keyword>
                          </TopicKeyword>
                          <TopicKeyword BuildFlags="" Id="2a64aeaf-0522-4076-bffd-942fa3caa9a7">
                            <Keyword m="2021-04-07T12:28:16.001854Z">VAROS FT4000B eKasa - fiškálna tlačiareň</Keyword>
