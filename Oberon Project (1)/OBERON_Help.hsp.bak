                      <TopicKeyword BuildFlags="" Id="b34ed55b-6068-4e3d-a7c4-1cb767987521">
                        <Keyword m="2021-09-08T10:35:15.4161665Z">Váhy - váhoskener</Keyword>
                      </TopicKeyword>
                      <TopicKeyword BuildFlags="" Id="9956eb78-65d9-48f8-9d6b-e62549678b7b">
                        <Keyword m="2021-09-08T10:35:10.4006401Z">Snímač čiarových kódov - váhoskener</Keyword>
                      </TopicKeyword>
