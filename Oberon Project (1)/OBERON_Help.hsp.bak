                      <TopicKeyword BuildFlags="" Id="c7b99e51-3e89-42e0-9174-9491ffc6f74e">
                        <Keyword m="2022-07-27T10:53:50.5800021Z">On-line internetový obchod - nastavenie komunikácie s OBERON-om</Keyword>
