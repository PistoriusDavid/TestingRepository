                      <TopicKeyword BuildFlags="" Id="1a7dda45-3f67-4fa2-bf31-948f164d3e56">
                        <Keyword m="2022-08-03T08:10:37.9061413Z">Off-line internetový obchod - nastavenie komunikácie s OBERON-om</Keyword>
                      </TopicKeyword>
