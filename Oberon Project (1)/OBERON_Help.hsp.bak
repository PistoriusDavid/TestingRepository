                  <TopicKeyword BuildFlags="" Id="6511001d-6b99-4553-aead-923d656c3e01">
                    <Keyword m="2021-08-04T11:17:49.9187835Z">Platby do banky</Keyword>
                  </TopicKeyword>
                  <TopicKeyword BuildFlags="" Id="55e0d95a-7239-44f6-b1fc-76aca67ebc12">
                    <Keyword m="2022-01-26T10:46:59.1402443Z">Overenie bankového účtu dodávateľa - platiteľa DPH - príkazy na úhradu</Keyword>
                  </TopicKeyword>
