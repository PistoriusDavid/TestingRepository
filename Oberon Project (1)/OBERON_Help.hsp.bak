        <DesignTimeContent m="2014-09-12T13:06:32.7543005Z">&lt;h1 class="hs-collapsibleheading"&gt;&lt;span onclick="toggleExpanded(event)" tabindex="0" onkeypress="toggleExpandedOnKey(event)" class="expandcollapse"&gt;&lt;img id=
