      <TopicCategory Id="80efe8a3-d9cd-45e4-9718-2a12d8a6f61b" AutoIndex="false">
        <Caption m="2014-08-31T16:15:57.5984047Z">News</Caption>
        <ChildTopicCategories />
        <Topics>
          <Topic Id="dc832235-0e36-4aac-ae54-e51641eb2f50" Status="Complete" CreatedOn="2014-10-27T13:19:33.4041641Z" ModifiedOn="2025-07-23T06:48:34.5883296Z" ModifiedBy="" PageTypeName="OBERON Standard.html" AutoIndex="true" HelpContextIds="" Name="OBERON_News_Previous" BuildFlags="{4AAE0FD4-7313-4FEE-A25F-0785B885F736},826B51BD-B6F0-4B2C-A814-029E169D018F">
            <Title m="2014-10-27T13:20:05.1979826Z">Čo bolo nové v predchádzajúcich verziách</Title>
            <ContentsTitle />
            <Notes></Notes>
            <CanonicalLink></CanonicalLink>
            <TopicSections>
              <TopicSection Name="BodyText">
                <Content m="2025-07-23T06:48:34.5883296Z">&lt;P&gt;V tejto téme &lt;EM&gt;Pomocníka&lt;/EM&gt; je možné nájsť informácie o zmenách, vylepšeniach a opravách v&amp;nbsp;predchádzajúcich verziách OBERON-u.&lt;/P&gt;
&lt;P&gt;&amp;nbsp;&lt;/P&gt;
&lt;P&gt;Predchádzajúce verzie:&lt;/P&gt;
&lt;P&gt;&lt;A href="0b7ac5dc-f7be-42c3-98f2-c77d3b20c46a"&gt;&lt;A href="2fc0a4bc-c3e4-4848-9f4e-700aa0a4c6f1"&gt;Jún/2025&lt;/A&gt;&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;Apríl/2025&lt;/P&gt;
&lt;P&gt;&lt;A href="d2cbffc3-0018-421d-8660-5af74ea4cd99"&gt;Marec/2025&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href="47c3a5ac-98fd-4b2b-86dd-0dba76b2c51a"&gt;Február/2025&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href="d7a0e74a-bb80-4d22-8da8-7683ef8234cb"&gt;Január/2025&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href="ee03b5f9-a2e0-4ead-833a-737554d5e480"&gt;December/2024&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href="8b99b3ec-3dc7-41dd-b3ed-ce935508483e"&gt;Október/2024&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href="44410dcc-1dbd-43c4-a623-a0f75c371fbb"&gt;Júl/2024&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href="126d72a2-223e-4907-824b-859fad46f02e"&gt;Máj/2024&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href="74b69347-9df2-4ec6-98dd-62cd68b2139f"&gt;Apríl/2024&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href="61652504-d947-43c3-a333-eacf464a05ad"&gt;Marec/2024&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href="eb9cbc22-3ce0-4970-a360-e4845ac29954"&gt;Január/2024&lt;/A&gt;&lt;/P&gt;</Content>
              </TopicSection>
            </TopicSections>
            <TopicLinks>
              <TopicLink BuildFlags="" Id="95e0ff7e-4f53-426d-8baa-2f2846f0f694" CategoryId="" TopicLinkCategorySource="TopicCategory" Target="9e299871-ce8b-4ead-819b-d86883603f85">
