                          <TopicKeyword BuildFlags="" Id="1b306d94-7abb-4e6c-8802-6c7e9698a8b8">
                            <Keyword m="2023-10-11T11:29:07.8112941Z">Dotykový displej - nastavenia programu</Keyword>
